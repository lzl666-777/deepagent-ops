# ==================== RAGFlow（内部知识库） ====================
# RAGFlow 服务地址（含端口，例如 http://1.2.3.4:9380）
RAGFLOW_API_URL=http://your-ragflow-host:9380
# RAGFlow 后台「API」页生成的 Key
RAGFLOW_API_KEY=ragflow-your-api-key

# ==================== LLM（DashScope / OpenAI 兼容） ====================
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=sk-your-dashscope-key
# 模型名，可按需换 qwen-max / qwen-flash 等
LLM_QWEN_PLUS=qwen-plus

# ==================== Tavily（联网市场情报） ====================
TAVILY_API_KEY=tvly-your-tavily-key

# ==================== MySQL（跨境电商业务数据） ====================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=crossborder_db
